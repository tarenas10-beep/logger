<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover">
<title>Iron Log</title>
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="theme-color" content="#14130F">
<link id="favicon" rel="icon" type="image/svg+xml">
<link id="appleIcon" rel="apple-touch-icon">
<link id="manifestLink" rel="manifest">
<style>
  :root{
    --bg:#14130F;
    --surface:#1B1A15;
    --line:#2E2B23;
    --text:#EDE8DD;
    --text-dim:#9A9686;
    --accent:#C08A3E;
    --accent-dim:#7A5C2A;
    --good:#6E8F5C;
    --bad:#B0503F;
    --radius:2px;
  }
  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
  html,body{margin:0;padding:0;background:var(--bg);color:var(--text);}
  body{
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
    -webkit-font-smoothing:antialiased;
    padding-bottom:40px;
    min-height:100vh;
  }
  input,button,textarea{font-family:inherit;}
  .wrap{max-width:560px;margin:0 auto;padding:0 18px;}

  header.top{
    padding:22px 18px 14px;
    display:flex;align-items:flex-end;justify-content:space-between;
    border-bottom:1px solid var(--line);
  }
  .brand{display:flex;flex-direction:column;gap:2px;}
  .brand h1{
    margin:0;font-size:22px;font-weight:800;letter-spacing:-0.02em;color:var(--text);
  }
  .brand .date{font-size:13px;color:var(--text-dim);}
  .unit-toggle{
    background:none;border:1px solid var(--line);color:var(--text-dim);
    font-size:12px;padding:6px 10px;border-radius:var(--radius);cursor:pointer;
  }
  .unit-toggle:active{border-color:var(--accent);color:var(--accent);}

  nav.days{
    display:flex;overflow-x:auto;gap:2px;padding:14px 18px 0;
    scrollbar-width:none;
  }
  nav.days::-webkit-scrollbar{display:none;}
  .day-pill{
    flex:0 0 auto;background:none;border:none;color:var(--text-dim);
    font-size:14px;font-weight:600;padding:8px 12px 12px;cursor:pointer;
    border-bottom:2px solid transparent;white-space:nowrap;
  }
  .day-pill.active{color:var(--text);border-bottom-color:var(--accent);}

  main{padding:20px 18px 0;}

  .workout-name-row{margin-bottom:18px;}
  .workout-name-row label{
    display:block;font-size:11px;color:var(--text-dim);margin-bottom:6px;
  }
  input.workout-name{
    background:none;border:none;border-bottom:1px solid var(--line);
    color:var(--text);font-size:24px;font-weight:800;letter-spacing:-0.01em;
    padding:2px 0 8px;width:100%;
  }
  input.workout-name:focus{outline:none;border-bottom-color:var(--accent);}

  .exercise{border-bottom:1px solid var(--line);}
  .exercise-row{
    display:flex;align-items:center;justify-content:space-between;
    padding:14px 0;cursor:pointer;
  }
  .exercise-row .name{font-size:16px;font-weight:600;}
  .exercise-row .meta{font-size:12px;color:var(--text-dim);margin-top:2px;}
  .exercise-row .right{display:flex;align-items:center;gap:10px;}
  .chev{color:var(--text-dim);font-size:13px;transition:transform .15s ease;}
  .exercise.open .chev{transform:rotate(90deg);color:var(--accent);}
  .del-btn{
    background:none;border:none;color:var(--text-dim);font-size:16px;
    padding:4px 6px;cursor:pointer;line-height:1;
  }
  .del-btn:active{color:var(--bad);}

  .exercise-body{display:none;padding:0 0 16px;}
  .exercise.open .exercise-body{display:block;}

  .set-log{margin:4px 0 12px;}
  .set-row{
    display:flex;align-items:center;gap:10px;padding:6px 0;
    font-size:14px;font-variant-numeric:tabular-nums;
  }
  .set-row .idx{color:var(--text-dim);width:16px;flex:0 0 auto;}
  .set-row .vals{flex:1;color:var(--text);}
  .set-row .rm{
    background:none;border:none;color:var(--text-dim);font-size:14px;cursor:pointer;
  }
  .set-row .rm:active{color:var(--bad);}
  .empty-note{font-size:13px;color:var(--text-dim);padding:4px 0 8px;}

  .add-set-form{display:flex;gap:8px;align-items:center;}
  .add-set-form input{
    background:var(--surface);border:1px solid var(--line);color:var(--text);
    font-size:15px;padding:9px 8px;border-radius:var(--radius);width:100%;
    font-variant-numeric:tabular-nums;
  }
  .add-set-form input:focus{outline:none;border-color:var(--accent);}
  .add-set-form label{font-size:10px;color:var(--text-dim);display:block;margin-bottom:4px;}
  .field{flex:1;min-width:0;}
  .add-set-btn{
    flex:0 0 auto;background:var(--accent);border:none;color:#14130F;
    font-weight:700;font-size:14px;padding:9px 14px;border-radius:var(--radius);
    cursor:pointer;align-self:flex-end;
  }
  .add-set-btn:active{background:var(--accent-dim);}

  .history-toggle{
    background:none;border:none;color:var(--accent);font-size:13px;
    padding:10px 0 0;cursor:pointer;font-weight:600;
  }
  .history{display:none;margin-top:10px;border-top:1px solid var(--line);padding-top:10px;}
  .history.open{display:block;}
  .history-entry{padding:6px 0;font-size:13px;color:var(--text-dim);}
  .history-entry .h-date{color:var(--text);font-weight:600;margin-right:8px;}

  .add-exercise{
    display:flex;gap:8px;padding:16px 0 24px;
  }
  .add-exercise input{
    flex:1;background:var(--surface);border:1px solid var(--line);color:var(--text);
    font-size:15px;padding:10px;border-radius:var(--radius);
  }
  .add-exercise input:focus{outline:none;border-color:var(--accent);}
  .add-exercise button{
    background:none;border:1px solid var(--accent);color:var(--accent);
    font-weight:700;font-size:14px;padding:10px 16px;border-radius:var(--radius);cursor:pointer;
  }
  .add-exercise button:active{background:var(--accent);color:#14130F;}

  .rest-day{
    text-align:center;padding:60px 20px;color:var(--text-dim);font-size:15px;
  }

  footer.note{
    max-width:560px;margin:0 auto;padding:10px 18px 30px;
    font-size:11px;color:var(--text-dim);
  }
</style>
</head>
<body>

<header class="top">
  <div class="brand">
    <h1>Iron Log</h1>
    <div class="date" id="todayLabel"></div>
  </div>
  <button class="unit-toggle" id="unitToggle">kg</button>
</header>

<nav class="days" id="dayPills"></nav>

<main id="dayContent"></main>

<footer class="note">Data is stored only in this browser (local storage). It stays on this device and isn't sent anywhere.</footer>

<script>
(function(){
  "use strict";

  var STORAGE_KEY = "ironlog_data_v1";
  var DAY_ORDER = ["mon","tue","wed","thu","fri","sat","sun"];
  var DAY_LABELS = {mon:"Mon",tue:"Tue",wed:"Wed",thu:"Thu",fri:"Fri",sat:"Sat",sun:"Sun"};
  var DAY_FULL = {mon:"Monday",tue:"Tuesday",wed:"Wednesday",thu:"Thursday",fri:"Friday",sat:"Saturday",sun:"Sunday"};

  function defaultData(){
    return {
      unit: "kg",
      workoutNames: {
        mon:"Push", tue:"Pull", wed:"Legs", thu:"Upper",
        fri:"Lower", sat:"Full body", sun:"Rest"
      },
      exercises: {
        mon:[mkEx("Bench press"),mkEx("Overhead press"),mkEx("Triceps pushdown")],
        tue:[mkEx("Deadlift"),mkEx("Bent-over row"),mkEx("Lat pulldown")],
        wed:[mkEx("Back squat"),mkEx("Leg press"),mkEx("Calf raise")],
        thu:[mkEx("Incline dumbbell press"),mkEx("Pull-up"),mkEx("Dumbbell curl")],
        fri:[mkEx("Front squat"),mkEx("Romanian deadlift"),mkEx("Leg curl")],
        sat:[mkEx("Clean and press"),mkEx("Chin-up"),mkEx("Plank")],
        sun:[]
      },
      logs: {}
    };
  }

  var idCounter = 0;
  function mkEx(name){
    idCounter++;
    return {id:"ex"+Date.now()+idCounter, name:name};
  }
  function newId(prefix){
    idCounter++;
    return prefix+Date.now()+idCounter;
  }

  function load(){
    try{
      var raw = localStorage.getItem(STORAGE_KEY);
      if(!raw) return defaultData();
      var parsed = JSON.parse(raw);
      if(!parsed.exercises || !parsed.workoutNames) return defaultData();
      if(!parsed.unit) parsed.unit = "kg";
      if(!parsed.logs) parsed.logs = {};
      return parsed;
    }catch(e){
      return defaultData();
    }
  }
  function save(){
    try{
      localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
    }catch(e){
      console.warn("Could not save to local storage:", e);
    }
  }

  var data = load();
  var todayIso = isoDate(new Date());
  var jsDay = new Date().getDay(); // 0=Sun..6=Sat
  var mapJsToKey = {0:"sun",1:"mon",2:"tue",3:"wed",4:"thu",5:"fri",6:"sat"};
  var activeDay = mapJsToKey[jsDay];
  var openExerciseId = null;
  var openHistoryId = null;

  function isoDate(d){
    var y=d.getFullYear(), m=("0"+(d.getMonth()+1)).slice(-2), dd=("0"+d.getDate()).slice(-2);
    return y+"-"+m+"-"+dd;
  }
  function formatDateLabel(d){
    return d.toLocaleDateString(undefined,{weekday:"short",month:"short",day:"numeric"});
  }
  function formatHistoryDate(iso){
    var d = new Date(iso+"T00:00:00");
    return d.toLocaleDateString(undefined,{month:"short",day:"numeric",year:"numeric"});
  }

  function getSets(dayKey, exId, dateIso){
    var byDate = data.logs[dateIso];
    if(!byDate) return [];
    var byDay = byDate[dayKey];
    if(!byDay) return [];
    return byDay[exId] || [];
  }
  function ensurePath(dayKey, exId, dateIso){
    if(!data.logs[dateIso]) data.logs[dateIso] = {};
    if(!data.logs[dateIso][dayKey]) data.logs[dateIso][dayKey] = {};
    if(!data.logs[dateIso][dayKey][exId]) data.logs[dateIso][dayKey][exId] = [];
    return data.logs[dateIso][dayKey][exId];
  }

  function historyForExercise(dayKey, exId){
    var out = [];
    var dates = Object.keys(data.logs).sort().reverse();
    for(var i=0;i<dates.length;i++){
      var d = dates[i];
      if(d === todayIso) continue;
      var sets = getSets(dayKey, exId, d);
      if(sets.length){
        out.push({date:d, sets:sets});
      }
      if(out.length >= 6) break;
    }
    return out;
  }

  function summarizeSets(sets){
    return sets.map(function(s){
      return s.reps+" \u00d7 "+s.weight+data.unit;
    }).join(", ");
  }

  // ---------- Rendering ----------

  function renderAll(){
    document.getElementById("todayLabel").textContent = formatDateLabel(new Date());
    document.getElementById("unitToggle").textContent = data.unit;
    renderDayPills();
    renderDayContent();
  }

  function renderDayPills(){
    var nav = document.getElementById("dayPills");
    nav.innerHTML = "";
    DAY_ORDER.forEach(function(key){
      var btn = document.createElement("button");
      btn.className = "day-pill" + (key === activeDay ? " active" : "");
      btn.textContent = DAY_LABELS[key];
      btn.addEventListener("click", function(){
        activeDay = key;
        openExerciseId = null;
        openHistoryId = null;
        renderAll();
      });
      nav.appendChild(btn);
    });
  }

  function renderDayContent(){
    var main = document.getElementById("dayContent");
    main.innerHTML = "";

    var wrapDiv = document.createElement("div");

    var nameRow = document.createElement("div");
    nameRow.className = "workout-name-row";
    var label = document.createElement("label");
    label.textContent = DAY_FULL[activeDay];
    var nameInput = document.createElement("input");
    nameInput.className = "workout-name";
    nameInput.value = data.workoutNames[activeDay] || "";
    nameInput.placeholder = "Name this day";
    nameInput.addEventListener("change", function(){
      data.workoutNames[activeDay] = nameInput.value.trim();
      save();
    });
    nameRow.appendChild(label);
    nameRow.appendChild(nameInput);
    wrapDiv.appendChild(nameRow);

    var list = data.exercises[activeDay] || [];

    if(list.length === 0){
      var restNote = document.createElement("div");
      restNote.className = "rest-day";
      restNote.textContent = "Nothing scheduled. Add an exercise below if you want to log something today.";
      wrapDiv.appendChild(restNote);
    } else {
      list.forEach(function(ex){
        wrapDiv.appendChild(renderExercise(ex));
      });
    }

    wrapDiv.appendChild(renderAddExercise());

    main.appendChild(wrapDiv);
  }

  function renderExercise(ex){
    var isOpen = ex.id === openExerciseId;
    var container = document.createElement("div");
    container.className = "exercise" + (isOpen ? " open" : "");

    var row = document.createElement("div");
    row.className = "exercise-row";

    var left = document.createElement("div");
    var nameEl = document.createElement("div");
    nameEl.className = "name";
    nameEl.textContent = ex.name;
    var todaySets = getSets(activeDay, ex.id, todayIso);
    var metaEl = document.createElement("div");
    metaEl.className = "meta";
    metaEl.textContent = todaySets.length
      ? todaySets.length + " set" + (todaySets.length>1?"s":"") + " logged today"
      : "No sets logged today";
    left.appendChild(nameEl);
    left.appendChild(metaEl);

    var right = document.createElement("div");
    right.className = "right";
    var delBtn = document.createElement("button");
    delBtn.className = "del-btn";
    delBtn.textContent = "\u00d7";
    delBtn.title = "Remove exercise";
    delBtn.addEventListener("click", function(e){
      e.stopPropagation();
      if(confirm('Remove "'+ex.name+'" from '+DAY_FULL[activeDay]+"? Logged history is kept.")){
        data.exercises[activeDay] = data.exercises[activeDay].filter(function(x){return x.id!==ex.id;});
        save();
        renderDayContent();
      }
    });
    var chev = document.createElement("span");
    chev.className = "chev";
    chev.textContent = "\u203a";
    right.appendChild(delBtn);
    right.appendChild(chev);

    row.appendChild(left);
    row.appendChild(right);
    row.addEventListener("click", function(){
      openExerciseId = isOpen ? null : ex.id;
      openHistoryId = null;
      renderDayContent();
    });

    container.appendChild(row);

    if(isOpen){
      container.appendChild(renderExerciseBody(ex));
    }

    return container;
  }

  function renderExerciseBody(ex){
    var body = document.createElement("div");
    body.className = "exercise-body";

    var setLog = document.createElement("div");
    setLog.className = "set-log";
    var todaySets = getSets(activeDay, ex.id, todayIso);

    if(todaySets.length === 0){
      var empty = document.createElement("div");
      empty.className = "empty-note";
      empty.textContent = "Log your first set for today below.";
      setLog.appendChild(empty);
    } else {
      todaySets.forEach(function(s, i){
        var row = document.createElement("div");
        row.className = "set-row";
        var idx = document.createElement("span");
        idx.className = "idx";
        idx.textContent = (i+1)+".";
        var vals = document.createElement("span");
        vals.className = "vals";
        vals.textContent = s.reps + " reps \u00d7 " + s.weight + data.unit;
        var rm = document.createElement("button");
        rm.className = "rm";
        rm.textContent = "remove";
        rm.addEventListener("click", function(){
          var arr = ensurePath(activeDay, ex.id, todayIso);
          arr.splice(i,1);
          save();
          renderDayContent();
        });
        row.appendChild(idx);
        row.appendChild(vals);
        row.appendChild(rm);
        setLog.appendChild(row);
      });
    }
    body.appendChild(setLog);

    var form = document.createElement("div");
    form.className = "add-set-form";

    var weightField = document.createElement("div");
    weightField.className = "field";
    var wLabel = document.createElement("label");
    wLabel.textContent = "Weight ("+data.unit+")";
    var wInput = document.createElement("input");
    wInput.type = "number";
    wInput.inputMode = "decimal";
    wInput.step = "0.5";
    wInput.min = "0";
    var lastWeight = todaySets.length ? todaySets[todaySets.length-1].weight : "";
    if(lastWeight !== "") wInput.value = lastWeight;
    weightField.appendChild(wLabel);
    weightField.appendChild(wInput);

    var repsField = document.createElement("div");
    repsField.className = "field";
    var rLabel = document.createElement("label");
    rLabel.textContent = "Reps";
    var rInput = document.createElement("input");
    rInput.type = "number";
    rInput.inputMode = "numeric";
    rInput.step = "1";
    rInput.min = "0";
    var lastReps = todaySets.length ? todaySets[todaySets.length-1].reps : "";
    if(lastReps !== "") rInput.value = lastReps;
    repsField.appendChild(rLabel);
    repsField.appendChild(rInput);

    var addBtn = document.createElement("button");
    addBtn.className = "add-set-btn";
    addBtn.textContent = "Add set";

    function submit(){
      var w = parseFloat(wInput.value);
      var r = parseInt(rInput.value,10);
      if(isNaN(w) || isNaN(r) || w<0 || r<0){
        wInput.focus();
        return;
      }
      var arr = ensurePath(activeDay, ex.id, todayIso);
      arr.push({weight:w, reps:r});
      save();
      renderDayContent();
      openExerciseId = ex.id;
    }
    addBtn.addEventListener("click", submit);
    rInput.addEventListener("keydown", function(e){
      if(e.key === "Enter") submit();
    });

    form.appendChild(weightField);
    form.appendChild(repsField);
    form.appendChild(addBtn);
    body.appendChild(form);

    var hist = historyForExercise(activeDay, ex.id);
    if(hist.length){
      var histToggle = document.createElement("button");
      histToggle.className = "history-toggle";
      var isHistOpen = openHistoryId === ex.id;
      histToggle.textContent = isHistOpen ? "Hide history" : "View history (" + hist.length + ")";
      histToggle.addEventListener("click", function(){
        openHistoryId = isHistOpen ? null : ex.id;
        renderDayContent();
      });
      body.appendChild(histToggle);

      if(isHistOpen){
        var histDiv = document.createElement("div");
        histDiv.className = "history open";
        hist.forEach(function(h){
          var entry = document.createElement("div");
          entry.className = "history-entry";
          var dateSpan = document.createElement("span");
          dateSpan.className = "h-date";
          dateSpan.textContent = formatHistoryDate(h.date);
          entry.appendChild(dateSpan);
          entry.appendChild(document.createTextNode(summarizeSets(h.sets)));
          histDiv.appendChild(entry);
        });
        body.appendChild(histDiv);
      }
    }

    return body;
  }

  function renderAddExercise(){
    var row = document.createElement("div");
    row.className = "add-exercise";
    var input = document.createElement("input");
    input.placeholder = "Add an exercise to " + DAY_FULL[activeDay];
    var btn = document.createElement("button");
    btn.textContent = "Add";

    function submit(){
      var name = input.value.trim();
      if(!name) return;
      if(!data.exercises[activeDay]) data.exercises[activeDay] = [];
      data.exercises[activeDay].push(mkEx(name));
      save();
      input.value = "";
      renderDayContent();
    }
    btn.addEventListener("click", submit);
    input.addEventListener("keydown", function(e){
      if(e.key === "Enter") submit();
    });

    row.appendChild(input);
    row.appendChild(btn);
    return row;
  }

  document.getElementById("unitToggle").addEventListener("click", function(){
    data.unit = data.unit === "kg" ? "lb" : "kg";
    save();
    renderAll();
  });

  // ---------- Lightweight PWA metadata (manifest via blob) ----------
  (function setupPwaMeta(){
    var iconSvg = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100">' +
      '<rect width="100" height="100" fill="#14130F"/>' +
      '<rect x="10" y="45" width="10" height="10" fill="#C08A3E"/>' +
      '<rect x="80" y="45" width="10" height="10" fill="#C08A3E"/>' +
      '<rect x="22" y="38" width="8" height="24" fill="#C08A3E"/>' +
      '<rect x="70" y="38" width="8" height="24" fill="#C08A3E"/>' +
      '<rect x="30" y="47" width="40" height="6" fill="#EDE8DD"/>' +
      '</svg>';
    var iconUrl = "data:image/svg+xml," + encodeURIComponent(iconSvg);
    document.getElementById("favicon").href = iconUrl;
    document.getElementById("appleIcon").href = iconUrl;

    var manifest = {
      name: "Iron Log",
      short_name: "Iron Log",
      start_url: ".",
      display: "standalone",
      background_color: "#14130F",
      theme_color: "#14130F",
      icons: [{ src: iconUrl, sizes: "100x100", type: "image/svg+xml" }]
    };
    try{
      var blob = new Blob([JSON.stringify(manifest)], {type:"application/json"});
      document.getElementById("manifestLink").href = URL.createObjectURL(blob);
    }catch(e){ /* manifest is a nice-to-have, safe to skip if unsupported */ }
  })();

  renderAll();
})();
</script>
</body>
</html>
